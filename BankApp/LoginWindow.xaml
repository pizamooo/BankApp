<Window x:Class="BankApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BankApp.ViewModels"
        xmlns:conv="clr-namespace:BankApp.Converters"
        Title="Авторизация"
        Height="620"
        Width="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F6FA"
        FontFamily="Segoe UI"
        FontSize="14">

	<Window.DataContext>
		<vm:LoginViewModel/>
	</Window.DataContext>

	<Window.Resources>

		<conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
		<conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility"/>

		<!-- CARD -->
		<Style x:Key="Card" TargetType="Border">
			<Setter Property="Background" Value="White"/>
			<Setter Property="CornerRadius" Value="14"/>
			<Setter Property="Padding" Value="30"/>
			<Setter Property="Margin" Value="25"/>
		</Style>

		<!-- LABEL -->
		<Style x:Key="Label" TargetType="TextBlock">
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Margin" Value="0,14,0,5"/>
			<Setter Property="Foreground" Value="#334155"/>
		</Style>

		<!-- INPUT BORDER -->
		<Style x:Key="InputBorder" TargetType="Border">
			<Setter Property="Background" Value="#F8FAFC"/>
			<Setter Property="BorderBrush" Value="#CBD5E1"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Height" Value="42"/>
		</Style>

		<!-- INPUT -->
		<Style x:Key="InputStyle" TargetType="Control">
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="14"/>
		</Style>

		<!-- ERROR -->
		<Style x:Key="ErrorStyle" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#EF4444"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Margin" Value="0,4,0,0"/>
		</Style>

		<!-- PRIMARY BUTTON -->
		<Style x:Key="PrimaryButton" TargetType="Button">
			<Setter Property="Height" Value="44"/>
			<Setter Property="Background" Value="#4F46E5"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Margin" Value="0,20,0,0"/>

			<Style.Triggers>

				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#4338CA"/>
				</Trigger>

				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Background" Value="#CBD5E1"/>
				</Trigger>

			</Style.Triggers>
		</Style>

		<!-- SECONDARY BUTTON -->
		<Style x:Key="SecondaryButton" TargetType="Button">
			<Setter Property="Height" Value="44"/>
			<Setter Property="Background" Value="#E2E8F0"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Margin" Value="0,10,0,0"/>
		</Style>

		<!-- EYE BUTTON -->
		<Style x:Key="EyeButton" TargetType="Button">
			<Setter Property="Width" Value="30"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,0,6,0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

	</Window.Resources>

	<Window.InputBindings>
		<KeyBinding Key="Enter"
                    Command="{Binding LoginCommand}"/>
	</Window.InputBindings>

	<Grid>

		<Border Style="{StaticResource Card}">

			<StackPanel VerticalAlignment="Center">

				<!-- TITLE -->
				<TextBlock Text="BankApp"
                           FontSize="34"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#1E293B"/>

				<TextBlock Text="Добро пожаловать"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,25"
                           Foreground="#64748B"/>

				<!-- LOGIN -->
				<TextBlock Text="Логин"
                           Style="{StaticResource Label}"/>

				<Border Style="{StaticResource InputBorder}">
					<TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}"
                             Padding="12,0"/>
				</Border>

				<TextBlock Text="{Binding LoginError}"
                           Style="{StaticResource ErrorStyle}"/>

				<!-- PASSWORD -->
				<TextBlock Text="Пароль"
                           Style="{StaticResource Label}"/>

				<Border Style="{StaticResource InputBorder}">

					<Grid>

						<PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource InputStyle}"
                                     Padding="12,0,40,0"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     Visibility="{Binding IsPasswordHidden,
                                     Converter={StaticResource BooleanToVisibilityConverter}}"/>

						<TextBox x:Name="PasswordTextBox"
                                 Style="{StaticResource InputStyle}"
                                 Padding="12,0,40,0"
                                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsPasswordHidden,
                                 Converter={StaticResource InverseBooleanToVisibility}}"/>

						<Button Style="{StaticResource EyeButton}"
                                Click="TogglePassword">

							<TextBlock Text="👁"
                                       FontSize="16"
                                       Foreground="#64748B"/>

						</Button>

					</Grid>

				</Border>

				<TextBlock Text="{Binding PasswordError}"
                           Style="{StaticResource ErrorStyle}"/>

				<!-- CAPS LOCK -->
				<TextBlock Text="Caps Lock включен"
                           Foreground="#F59E0B"
                           Margin="0,8,0,0"
                           Visibility="{Binding IsCapsLockOn,
                           Converter={StaticResource BooleanToVisibilityConverter}}"/>

				<!-- REMEMBER -->
				<CheckBox Content="Запомнить меня"
                          Margin="0,15,0,0"
                          IsChecked="{Binding RememberMe}"/>

				<!-- BLOCK -->
				<TextBlock Text="Аккаунт временно заблокирован"
                           Foreground="#DC2626"
                           FontWeight="Bold"
                           Margin="0,15,0,0"
                           Visibility="{Binding IsBlocked,
                           Converter={StaticResource BooleanToVisibilityConverter}}"/>

				<!-- BUTTONS -->
				<Button Content="Войти"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding CanLogin}"/>

				<Button Content="Регистрация"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenRegisterCommand}"/>

			</StackPanel>

		</Border>

	</Grid>

</Window>