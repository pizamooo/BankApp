<UserControl x:Class="BankApp.Views.TransfersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	
	<Grid Background="#F5F7FB">


		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- MAIN -->
		<ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto">

			<StackPanel Width="430"
                        Margin="25">

				<!-- HEADER -->
				<TextBlock Text="💸 Переводы"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"
                           Margin="0,0,0,25"
						   HorizontalAlignment="Center"/>

				<!-- CARD -->
				<Border Background="White"
                        CornerRadius="18"
                        Padding="20">

					<StackPanel>

						<!-- ACCOUNT -->
						<TextBlock Text="Счет отправителя"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

						<ComboBox ItemsSource="{Binding Accounts}"
                                  SelectedItem="{Binding SelectedFromAccount}"
                                  DisplayMemberPath="Iban"
                                  Height="42"
                                  FontSize="14"
                                  Margin="0,0,0,12"/>

						<!-- BALANCE -->
						<Border Background="#EEF2FF"
                                Padding="12"
                                CornerRadius="12"
                                Margin="0,0,0,18">

							<StackPanel Orientation="Horizontal">

								<TextBlock Text="💰"
                                           FontSize="18"
                                           Margin="0,0,8,0"/>

								<TextBlock Text="{Binding SelectedBalance,
                                    StringFormat=Доступно: {0:N2} ₽}"
                                           FontWeight="Bold"
                                           FontSize="15"/>
							</StackPanel>
						</Border>

						<!-- IBAN -->
						<TextBlock Text="IBAN получателя"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

						<TextBox Text="{Binding Iban}"
                                 Height="42"
                                 FontSize="14"
                                 Padding="10"
								 MaxLength="19"
								 PreviewTextInput="Iban_PreviewTextInput"
								 DataObject.Pasting="Iban_Pasting"
                                 Margin="0,0,0,16"/>

						<TextBlock Text="или" 
								   HorizontalAlignment="Center" 
								   Foreground="Black" 
								   Margin="0,-10,0,10"
								   FontSize="12"/>

						<TextBlock Text="Телефон получателя"
								   FontWeight="SemiBold"
								   Margin="0,0,0,6"/>

						<TextBox Text="{Binding PhoneNumber,
                UpdateSourceTrigger=PropertyChanged}"
								 Height="42"
								 FontSize="14"
								 Padding="10"
								 MaxLength="11"
								 PreviewTextInput="OnlyNumbers_PreviewTextInput"
								 DataObject.Pasting="Phone_Pasting"
								 Margin="0,0,0,16"/>

						<!-- AMOUNT -->
						<TextBlock Text="Сумма перевода"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

						<TextBox Text="{Binding AmountText,
                                 UpdateSourceTrigger=PropertyChanged}"
                                 Height="42"
                                 FontSize="16"
                                 Padding="10"
								 PreviewTextInput="Amount_PreviewTextInput"
								 DataObject.Pasting="Amount_Pasting"
                                 Margin="0,0,0,16"/>

						<!-- INFO -->
						<Border Background="#F9FAFB"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,0,0,16">

							<StackPanel>

								<DockPanel Margin="0,0,0,6">

									<TextBlock Text="Комиссия"
                                               Foreground="#6B7280"/>

									<TextBlock Text="{Binding Commission,
                                        StringFormat={}{0:N2} ₽}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right"/>

								</DockPanel>

								<DockPanel>

									<TextBlock Text="Итого"
                                               FontWeight="Bold"/>

									<TextBlock Text="{Binding Total,
                                        StringFormat={}{0:N2} ₽}"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               HorizontalAlignment="Right"/>

								</DockPanel>

							</StackPanel>

						</Border>

						<!-- RECEIVER -->
						<Border Background="#ECFDF5"
								CornerRadius="12"
								Padding="12"
								Margin="0,0,0,12">

							<TextBlock Text="{Binding ReceiverName}"
									   Foreground="#065F46"
									   FontWeight="Bold"
									   FontSize="14"/>
						</Border>

						<!-- INFO -->
						<TextBlock Text="{Binding TransferInfo}"
                                   Foreground="#DC2626"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,14"/>

						<!-- SEND -->
						<Button Content="Отправить перевод"
                                Height="48"
                                FontSize="15"
                                FontWeight="Bold"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding TransferCommand}"/>

					</StackPanel>

				</Border>

				<!-- HISTORY -->
				<TextBlock Text="История переводов"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,28,0,18"
						   HorizontalAlignment="Center"/>

				<ListBox ItemsSource="{Binding Transfers}"
         BorderThickness="0"
         Background="Transparent"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         SelectedItem="{Binding SelectedTransfer}"
         SelectionMode="Single">

					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<Setter Property="Focusable" Value="True"/>
							<Setter Property="Background" Value="Transparent"/>
							<Setter Property="BorderThickness" Value="0"/>
							<Setter Property="Padding" Value="0"/>
							<Setter Property="Margin" Value="0,0,0,14"/>
							<Setter Property="HorizontalContentAlignment" Value="Stretch"/>

							<!-- Визуальное выделение -->
							<Style.Triggers>
								<Trigger Property="IsSelected" Value="True">
									<Setter Property="Background" Value="#E0F2FE"/>
									<Setter Property="BorderBrush" Value="#3B82F6"/>
									<Setter Property="BorderThickness" Value="3"/>
								</Trigger>
							</Style.Triggers>
						</Style>
					</ListBox.ItemContainerStyle>

					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border x:Name="Bubble"
                    Padding="18"
                    CornerRadius="22"
                    Margin="0,4"
                    Cursor="Hand"
                    MaxWidth="340"
                    Background="White">

								<Border.Effect>
									<DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.10"/>
								</Border.Effect>

								<StackPanel>
									<TextBlock x:Name="IconText" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,10"/>
									<TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" TextAlignment="Center"/>
									<TextBlock Text="{Binding Description}" Margin="0,8,0,10" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.85"/>
									<TextBlock x:Name="AmountBlock" Text="{Binding AmountText}" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center"/>
									<TextBlock Text="{Binding DateText}" Margin="0,10,0,0" FontSize="11" HorizontalAlignment="Center" Opacity="0.6"/>
								</StackPanel>
							</Border>

							<DataTemplate.Triggers>
								<!-- Hover -->
								<Trigger SourceName="Bubble" Property="IsMouseOver" Value="True">
									<Setter TargetName="Bubble" Property="Opacity" Value="0.92"/>
								</Trigger>

								<!-- Incoming / Outgoing стили -->
								<DataTrigger Binding="{Binding IsIncoming}" Value="True">
									<Setter TargetName="Bubble" Property="Background" Value="#DCFCE7"/>
									<Setter TargetName="IconText" Property="Text" Value="📥"/>
									<Setter TargetName="AmountBlock" Property="Foreground" Value="#16A34A"/>
								</DataTrigger>
								<DataTrigger Binding="{Binding IsIncoming}" Value="False">
									<Setter TargetName="Bubble" Property="Background" Value="#DBEAFE"/>
									<Setter TargetName="IconText" Property="Text" Value="📤"/>
									<Setter TargetName="AmountBlock" Property="Foreground" Value="#2563EB"/>
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</StackPanel>
		</ScrollViewer>

		<!-- BACK BUTTON -->
		<Border Grid.Row="1"
                Background="White"
                Padding="18"
                BorderBrush="#E5E7EB"
                BorderThickness="1,1,0,0">

			<Button Content="← Назад"
                    Width="140"
                    Height="42"
                    FontWeight="Bold"
                    Background="#2563EB"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding GoBackCommand}"/>

			
		</Border>
		<Button Content="🧾 Экспорт чека"
                Grid.Column="0"
				Width="140"
				Height="44"
                Padding="20,12"
                FontSize="15"
                FontWeight="SemiBold"
                Background="#10B981"
                Foreground="White"
				HorizontalAlignment="Left"
				VerticalAlignment="Bottom"
                BorderThickness="0"
				Margin="20,0,0,10"
                Cursor="Hand"
                Command="{Binding ExportReceiptCommand}"/>
		
		<Button Content="↑"
        Width="44"
        Height="44"
        FontSize="20"
        FontWeight="Bold"
        Background="#2563EB"
        Foreground="White"
        BorderThickness="0"
        Cursor="Hand"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Margin="0,0,20,10"
        Click="ScrollToTop_Click"/>
	</Grid>

</UserControl>