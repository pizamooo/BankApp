<UserControl x:Class="BankApp.Views.TransfersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BankApp.ViewModels">

	<UserControl.DataContext>
		<vm:TransfersViewModel/>
	</UserControl.DataContext>

	<Grid Margin="20">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- ====== ПЕРЕВОД ====== -->
		<Border Grid.Row="0"
                Background="White"
                CornerRadius="10"
                Padding="20">

			<StackPanel>

				<TextBlock Text="Перевод между счетами"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0 0 0 15"/>

				<WrapPanel>

					<!-- ОТКУДА -->
					<StackPanel Margin="10">
						<TextBlock Text="Откуда"/>

						<ComboBox Width="200"
                                  ItemsSource="{Binding Accounts}"
                                  SelectedItem="{Binding FromAccount}"
                                  DisplayMemberPath="AccountNumber"/>
					</StackPanel>

					<!-- КУДА -->
					<StackPanel Margin="10">
						<TextBlock Text="Куда"/>

						<ComboBox Width="200"
                                  ItemsSource="{Binding Accounts}"
                                  SelectedItem="{Binding ToAccount}"
                                  DisplayMemberPath="AccountNumber"/>
					</StackPanel>

					<!-- СУММА -->
					<StackPanel Margin="10">
						<TextBlock Text="Сумма"/>
						<TextBox Width="120"
                                 Text="{Binding TransferAmount, UpdateSourceTrigger=PropertyChanged}"/>
					</StackPanel>

					<!-- КОМИССИЯ -->
					<StackPanel Margin="10">
						<TextBlock Text="Комиссия"/>
						<TextBox Width="120"
                                 IsReadOnly="True"
                                 Text="{Binding Commission}"/>
					</StackPanel>

					<!-- КНОПКА -->
					<StackPanel Margin="10" VerticalAlignment="Bottom">
						<Button Content="Перевести"
                                Width="150"
                                Height="35"
                                Command="{Binding TransferCommand}"/>
					</StackPanel>

				</WrapPanel>

			</StackPanel>

		</Border>

		<!-- ====== ФИЛЬТР ====== -->
		<Grid Grid.Row="1" Width="200" Margin="10 0 0 0" HorizontalAlignment="Left">

			<!-- Подсказка -->
			<TextBlock Text="Поиск по счету, сумме или дате"
               Foreground="Gray"
               VerticalAlignment="Center"
					   Margin="8 0 0 0"
               IsHitTestVisible="False">

				<TextBlock.Style>
					<Style TargetType="TextBlock">
						<Setter Property="Visibility" Value="Collapsed"/>
						<Style.Triggers>
							<DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
								<Setter Property="Visibility" Value="Visible"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>

			</TextBlock>

			<!-- Сам ввод -->
			<TextBox x:Name="SearchBox"
             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
             Background="Transparent"
					 Height="20"
					 Margin="5"
					 FontSize="14"/>
		</Grid>

		<!-- ====== ТАБЛИЦА ====== -->
		<DataGrid Grid.Row="2"
                  ItemsSource="{Binding Transfers}"
                  AutoGenerateColumns="False"
                  GridLinesVisibility="None"
                  IsReadOnly="True">

			<DataGrid.Columns>

				<DataGridTextColumn Header="Откуда"
                                    Binding="{Binding FromAccountNumber}" />

				<DataGridTextColumn Header="Куда"
                                    Binding="{Binding ToAccountNumber}" />

				<DataGridTextColumn Header="Сумма"
                                    Binding="{Binding Amount}" />

				<DataGridTextColumn Header="Комиссия"
                                    Binding="{Binding Commission}">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="Foreground" Value="Orange"/>
							<Setter Property="FontWeight" Value="Bold"/>
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>

				<DataGridTextColumn Header="Дата"
                                    Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" />

			</DataGrid.Columns>

		</DataGrid>

	</Grid>

</UserControl>