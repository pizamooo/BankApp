<UserControl x:Class="BankApp.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BankApp.ViewModels"
             mc:Ignorable="d"
             Background="#F4F6F9">

	<UserControl.DataContext>
		<vm:AdminDashboardViewModel/>
	</UserControl.DataContext>

	<ScrollViewer VerticalScrollBarVisibility="Auto">

		<Grid Margin="20">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- HEADER -->

			<Border Background="White"
                    CornerRadius="18"
                    Padding="25"
                    Margin="0 0 0 20">

				<StackPanel>

					<TextBlock Text="Панель администратора"
                               FontSize="30"
                               FontWeight="Bold"/>

					<TextBlock Text="Мониторинг системы и управление банком"
                               Foreground="Gray"
                               Margin="0 5 0 0"/>

				</StackPanel>

			</Border>

			<!-- STATS -->

			<UniformGrid Grid.Row="1"
                         Columns="5"
                         Margin="0 0 0 20">

				<!-- USERS -->

				<Border Background="White"
                        CornerRadius="18"
                        Padding="20"
                        Margin="5">

					<StackPanel>

						<TextBlock Text="Пользователей"
                                   Foreground="Gray"
                                   FontSize="14"/>

						<TextBlock Text="{Binding UsersCount}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0 10 0 0"/>

					</StackPanel>

				</Border>

				<!-- ACCOUNTS -->

				<Border Background="White"
                        CornerRadius="18"
                        Padding="20"
                        Margin="5">

					<StackPanel>

						<TextBlock Text="Счетов"
                                   Foreground="Gray"
                                   FontSize="14"/>

						<TextBlock Text="{Binding AccountsCount}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"
                                   Margin="0 10 0 0"/>

					</StackPanel>

				</Border>

				<!-- MONEY -->

				<Border Background="White"
                        CornerRadius="18"
                        Padding="5"
						VerticalAlignment="Center"
                        Margin="5">

					<StackPanel>

						<TextBlock Text="Общая сумма банка"
                                   Foreground="Gray"
                                   FontSize="14"/>

						<TextBlock Text="{Binding TotalBankBalance,
                                          StringFormat={}{0:N2} ₽}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   Margin="0 10 0 0"/>

					</StackPanel>

				</Border>

				<Border Background="White"
        CornerRadius="18"
        Padding="20"
        Margin="5">

					<StackPanel>

						<TextBlock Text="Операторов"
                   Foreground="Gray"
                   FontSize="14"/>

						<TextBlock Text="{Binding OperatorsCount}"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="#9333EA"
                   Margin="0 10 0 0"/>

					</StackPanel>

				</Border>

				<Border Background="White"
        CornerRadius="18"
        Padding="20"
        Margin="5">

					<StackPanel>

						<TextBlock Text="Активные счета"
                   Foreground="Gray"
                   FontSize="14"/>

						<TextBlock Text="{Binding ActiveAccountsCount}"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="#16A34A"
                   Margin="0 10 0 0"/>

					</StackPanel>

				</Border>

				<Border Background="White"
        CornerRadius="18"
        Padding="20"
        Margin="5">

					<StackPanel>

						<TextBlock Text="Закрытые счета"
                   Foreground="Gray"
                   FontSize="14"/>

						<TextBlock Text="{Binding ClosedAccountsCount}"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="#DC2626"
                   Margin="0 10 0 0"/>

					</StackPanel>

				</Border>

			</UniformGrid>

			<!-- LAST USERS -->

			<Border Grid.Row="2"
                    Background="White"
                    CornerRadius="18"
                    Padding="20">

				<StackPanel>

					<TextBlock Text="Последние пользователи"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0 0 0 15"/>

					<DataGrid ItemsSource="{Binding LastUsers}"
                              AutoGenerateColumns="False"
							  GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              CanUserResizeColumns="False"
                              IsReadOnly="True"
                              BorderThickness="0"
                              RowHeight="40">

						<DataGrid.Columns>

							<DataGridTextColumn Header="ID"
                                                Binding="{Binding Id}"
                                                Width="80"/>

							<DataGridTextColumn Header="ФИО"
                                                Binding="{Binding FullName}"
                                                Width="*"/>

							<DataGridTextColumn Header="Телефон"
                                                Binding="{Binding Phone}"
                                                Width="180"/>

							<DataGridTextColumn Header="Роль"
                                                Binding="{Binding Role}"
                                                Width="140"/>

						</DataGrid.Columns>

					</DataGrid>

				</StackPanel>

			</Border>

			<Border Grid.Row="3"
        Background="White"
        CornerRadius="18"
        Padding="20"
        Margin="0 20 0 0">

				<StackPanel>

					<TextBlock Text="Системные логи"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0 0 0 15"/>

					<Grid Margin="0 0 0 15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="200"/>
							<ColumnDefinition Width="20"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<!-- SEARCH -->
						<Grid Grid.Column="0">
							<TextBox Height="36"
                 Padding="10 0"
                 VerticalContentAlignment="Center"
                 Text="{Binding LogSearch, UpdateSourceTrigger=PropertyChanged}" />
						</Grid>

						<!-- PLACEHOLDER -->
						<TextBlock Grid.Column="0"
               Text="Поиск по логам..."
               Margin="14 0 0 0"
               VerticalAlignment="Center"
               Foreground="Gray"
               IsHitTestVisible="False">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Visibility" Value="Collapsed"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding LogSearch}" Value="">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
										<DataTrigger Binding="{Binding LogSearch}" Value="{x:Null}">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>

						<!-- COMBO -->
						<StackPanel Grid.Column="3" Margin="10 0 0 0">
							<TextBlock Text="Тип действия"
                   FontSize="12"
                   Foreground="Gray"/>
							<ComboBox Width="240"
                  Height="36"
                  ItemsSource="{Binding LogActions}"
                  SelectedItem="{Binding SelectedLogAction}"/>
						</StackPanel>
					</Grid>

					<DataGrid ItemsSource="{Binding Logs}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
							  GridLinesVisibility="None"
                  IsReadOnly="True"
                  BorderThickness="0"
                  RowHeight="40">

						<DataGrid.Columns>

							<DataGridTextColumn Header="Дата"
                                    Width="180"
                                    Binding="{Binding CreatedAt,
                                    StringFormat=dd.MM.yyyy HH:mm}"/>

							<DataGridTextColumn Header="Пользователь"
                                    Width="220"
                                    Binding="{Binding FullName}"/>

							<DataGridTemplateColumn Header="Действие"
                        Width="220">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Border Padding="8 4"
                    CornerRadius="10">
											<Border.Style>
												<Style TargetType="Border">
													<Setter Property="Background"
                                Value="#DBEAFE"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding Action}"
                                         Value="Отмена операции">
															<Setter Property="Background"
                                        Value="#db5c5c"/>
														</DataTrigger>
														<DataTrigger Binding="{Binding Action}"
                                         Value="Создание операции">
															<Setter Property="Background"
                                        Value="#DCFCE7"/>
														</DataTrigger>
														<DataTrigger Binding="{Binding Action}"
                                         Value="Экспорт в PDF">
															<Setter Property="Background"
                                        Value="#FEF3C7"/>
														</DataTrigger>
														<DataTrigger Binding="{Binding Action}" Value="Открытие счета">
															<Setter Property="Background" 
																	Value="#DCFCE7"/>
														</DataTrigger>
														<DataTrigger Binding="{Binding Action}" Value="Экспорт в Excel">
															<Setter Property="Background"
																	Value="#FEF3C7"/>
														</DataTrigger>
														<DataTrigger Binding="{Binding Action}" Value="Закрытие счета">
															<Setter Property="Background"
												Value="#db5c5c"/>
														</DataTrigger>
														<DataTrigger Binding="{Binding Action}" Value="Закрытие всех счетов">
															<Setter Property="Background"
												Value="#db5c5c"/>
														</DataTrigger>
														<DataTrigger Binding="{Binding Action}" Value="Блокировка пользователя">
															<Setter Property="Background"
																	Value="#db5c5c"/>
														</DataTrigger>
														<DataTrigger Binding="{Binding Action}" Value="Разблокировка пользователя">
															<Setter Property="Background"
												Value="#DCFCE7"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Border.Style>

											<TextBlock Text="{Binding Action}"
                           FontWeight="SemiBold"/>
										</Border>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>

							<DataGridTemplateColumn Header="Описание" Width="*">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Description}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
						</DataGrid.Columns>
					</DataGrid>
				</StackPanel>
			</Border>
		</Grid>

	</ScrollViewer>

</UserControl>