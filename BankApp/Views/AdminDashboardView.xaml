<UserControl x:Class="BankApp.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BankApp.ViewModels"
             mc:Ignorable="d"
             Background="#F4F6F9">
	<UserControl.Resources>
		<Style x:Key="ModernGridStyle"
       TargetType="DataGrid">

			<Setter Property="Background"
            Value="Transparent"/>

			<Setter Property="BorderThickness"
            Value="0"/>

			<Setter Property="GridLinesVisibility"
            Value="None"/>

			<Setter Property="HeadersVisibility"
            Value="Column"/>

			<Setter Property="RowHeight"
            Value="50"/>

			<Setter Property="CanUserResizeColumns"
            Value="False"/>

			<Setter Property="AlternatingRowBackground"
            Value="#F8FAFC"/>

			<Setter Property="RowBackground"
            Value="White"/>

			<Setter Property="FontSize"
            Value="14"/>

		</Style>


		<Style x:Key="ModernHeaderStyle"
       TargetType="DataGridColumnHeader">

			<Setter Property="Background"
            Value="#F1F5F9"/>

			<Setter Property="Foreground"
            Value="#475569"/>

			<Setter Property="FontWeight"
            Value="Bold"/>

			<Setter Property="Padding"
            Value="15,10"/>

			<Setter Property="BorderThickness"
            Value="0"/>

		</Style>


		<Style x:Key="ModernRowStyle"
       TargetType="DataGridRow">

			<Setter Property="Background"
            Value="White"/>

			<Setter Property="BorderThickness"
            Value="0"/>

			<Setter Property="Cursor"
            Value="Hand"/>

			<Style.Triggers>

				<Trigger Property="IsMouseOver"
                 Value="True">

					<Setter Property="Background"
                    Value="#EEF4FF"/>

				</Trigger>

				<Trigger Property="IsSelected"
                 Value="True">

					<Setter Property="Background"
                    Value="#DBEAFE"/>

				</Trigger>

			</Style.Triggers>

		</Style>
	</UserControl.Resources>

	<UserControl.DataContext>
		<vm:AdminDashboardViewModel/>
	</UserControl.DataContext>

	<ScrollViewer VerticalScrollBarVisibility="Auto">

		<Grid Margin="20">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- HEADER -->

			<Border Background="White"
                    CornerRadius="18"
                    Padding="25"
                    Margin="0 0 0 20">

				<StackPanel>

					<TextBlock Text="Панель администратора"
                               FontSize="30"
                               FontWeight="Bold"/>

					<TextBlock Text="Мониторинг системы и управление банком"
                               Foreground="Gray"
                               Margin="0 5 0 0"/>

				</StackPanel>

			</Border>

			<!-- STATS -->

			<Grid Grid.Row="1"
      Margin="0 0 0 20">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="1.7*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!-- Пользователи -->
				<Border Grid.Column="0"
            Background="White"
            CornerRadius="18"
            Padding="20"
            Margin="5">

					<StackPanel>
						<TextBlock Text="Пользователей"
                       Foreground="Gray"
                       FontSize="14"/>

						<TextBlock Text="{Binding UsersCount}"
                       FontSize="30"
                       FontWeight="Bold"
                       Margin="0 10 0 0"/>
					</StackPanel>

				</Border>

				<!-- Счета -->
				<Border Grid.Column="1"
            Background="White"
            CornerRadius="18"
            Padding="20"
            Margin="5">

					<StackPanel>
						<TextBlock Text="Счетов"
                       Foreground="Gray"
                       FontSize="14"/>

						<TextBlock Text="{Binding AccountsCount}"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#2563EB"
                       Margin="0 10 0 0"/>
					</StackPanel>

				</Border>

				<!-- Общая сумма банка -->
				<Border Grid.Column="2"
            Background="White"
            CornerRadius="18"
            Padding="20"
            Margin="5">

					<StackPanel>

						<TextBlock Text="Общая сумма банка"
                       Foreground="Gray"
                       FontSize="14"/>

						<TextBlock Text="{Binding TotalBankBalance,
                              StringFormat={}{0:N2} ₽}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#16A34A"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Margin="0 10 0 0"/>

					</StackPanel>

				</Border>

				<!-- Операторы -->
				<Border Grid.Column="3"
            Background="White"
            CornerRadius="18"
            Padding="20"
            Margin="5">
					<StackPanel>

						<TextBlock Text="Операторов"
Foreground="Gray"
FontSize="14"/>

						<TextBlock Text="{Binding OperatorsCount}"
FontSize="30"
FontWeight="Bold"
Foreground="#9333EA"
Margin="0 10 0 0"/>

					</StackPanel>
				</Border>

				<!-- Активные -->
				<Border Grid.Column="4"
            Background="White"
            CornerRadius="18"
            Padding="20"
            Margin="5">
					<StackPanel>

						<TextBlock Text="Активные счета"
Foreground="Gray"
FontSize="14"/>

						<TextBlock Text="{Binding ActiveAccountsCount}"
FontSize="30"
FontWeight="Bold"
Foreground="#16A34A"
Margin="0 10 0 0"/>

					</StackPanel>
				</Border>

				<!-- Закрытые -->
				<Border Grid.Column="5"
            Background="White"
            CornerRadius="18"
            Padding="20"
            Margin="5">
					<StackPanel>

						<TextBlock Text="Закрытые счета"
Foreground="Gray"
FontSize="14"/>

						<TextBlock Text="{Binding ClosedAccountsCount}"
FontSize="30"
FontWeight="Bold"
Foreground="#DC2626"
Margin="0 10 0 0"/>

					</StackPanel>
				</Border>

			</Grid>

			<!-- LAST USERS -->

			<Border Grid.Row="2"
                    Background="White"
                    CornerRadius="18"
                    Padding="20">

				<StackPanel>

					<TextBlock Text="Последние пользователи"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0 0 0 15"/>

					<DataGrid ItemsSource="{Binding LastUsers}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          Style="{StaticResource ModernGridStyle}"
          RowStyle="{StaticResource ModernRowStyle}"
          ColumnHeaderStyle="{StaticResource ModernHeaderStyle}">

						<DataGrid.Columns>

							<DataGridTextColumn Header="#"
                            Width="70"
                            Binding="{Binding Id}"/>

							<DataGridTextColumn Header="ФИО"
                            Width="*"
                            Binding="{Binding FullName}"/>

							<DataGridTextColumn Header="Телефон"
                            Width="180"
                            Binding="{Binding Phone}"/>

							<!-- Красивый статус роли -->

							<DataGridTemplateColumn Header="Роль"
                                Width="180">

								<DataGridTemplateColumn.CellTemplate>

									<DataTemplate>

										<Border Padding="10,4"
                            CornerRadius="10"
                            HorizontalAlignment="Center">

											<Border.Style>

												<Style TargetType="Border">

													<Setter Property="Background"
                                        Value="#DBEAFE"/>

													<Style.Triggers>

														<DataTrigger Binding="{Binding Role}"
                                                 Value="Admin">

															<Setter Property="Background"
                                                Value="#FEE2E2"/>

														</DataTrigger>

														<DataTrigger Binding="{Binding Role}"
                                                 Value="Operator">

															<Setter Property="Background"
                                                Value="#FEF3C7"/>

														</DataTrigger>

														<DataTrigger Binding="{Binding Role}"
                                                 Value="Client">

															<Setter Property="Background"
                                                Value="#DCFCE7"/>

														</DataTrigger>

													</Style.Triggers>

												</Style>

											</Border.Style>

											<TextBlock Text="{Binding Role}"
                                   FontWeight="Bold"/>

										</Border>

									</DataTemplate>

								</DataGridTemplateColumn.CellTemplate>

							</DataGridTemplateColumn>

						</DataGrid.Columns>

					</DataGrid>

				</StackPanel>

			</Border>

			<Border Grid.Row="3"
        Background="White"
        CornerRadius="18"
        Padding="20"
        Margin="0 20 0 0">

				<StackPanel>

					<TextBlock Text="Системные логи"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0 0 0 15"/>

					<Grid Margin="0 0 0 15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="200"/>
							<ColumnDefinition Width="20"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<!-- SEARCH -->
						<Grid Grid.Column="0">
							<TextBox Height="36"
                 Padding="10 0"
                 VerticalContentAlignment="Center"
                 Text="{Binding LogSearch, UpdateSourceTrigger=PropertyChanged}" />
						</Grid>

						<!-- PLACEHOLDER -->
						<TextBlock Grid.Column="0"
               Text="Поиск по логам..."
               Margin="14 0 0 0"
               VerticalAlignment="Center"
               Foreground="Gray"
               IsHitTestVisible="False">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Visibility" Value="Collapsed"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding LogSearch}" Value="">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
										<DataTrigger Binding="{Binding LogSearch}" Value="{x:Null}">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>

						<!-- COMBO -->
						<StackPanel Grid.Column="3" Margin="10 0 0 0">
							<TextBlock Text="Тип действия"
                   FontSize="12"
                   Foreground="Gray"/>
							<ComboBox Width="240"
                  Height="36"
                  ItemsSource="{Binding LogActions}"
                  SelectedItem="{Binding SelectedLogAction}"/>
						</StackPanel>
					</Grid>

					<DataGrid ItemsSource="{Binding Logs}"
							  MaxHeight="400"
							  ScrollViewer.VerticalScrollBarVisibility="Auto"
							  Style="{StaticResource ModernGridStyle}"
							  RowStyle="{StaticResource ModernRowStyle}"
							  ColumnHeaderStyle="{StaticResource ModernHeaderStyle}"
							  AlternationCount="2"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
							  GridLinesVisibility="None"
                  IsReadOnly="True"
                  BorderThickness="0"
                  RowHeight="40">

						<DataGrid.Columns>

							<DataGridTextColumn Header="Дата"
                                    Width="180"
                                    Binding="{Binding CreatedAt,
                                    StringFormat=dd.MM.yyyy HH:mm}"/>

							<DataGridTextColumn Header="Пользователь"
                                    Width="220"
                                    Binding="{Binding FullName}"/>

							<DataGridTemplateColumn Header="Действие"
                        Width="220">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Border Padding="8 4"
                    CornerRadius="10">
											<Border.Style>
												<Style TargetType="Border">
													<Setter Property="Background"
                                Value="#DBEAFE"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding Action}"
                                         Value="Отмена операции">
															<Setter Property="Background"
                                        Value="#db5c5c"/>
														</DataTrigger>
														<DataTrigger Binding="{Binding Action}"
                                         Value="Создание операции">
															<Setter Property="Background"
                                        Value="#DCFCE7"/>
														</DataTrigger>
														<DataTrigger Binding="{Binding Action}"
                                         Value="Экспорт в PDF">
															<Setter Property="Background"
                                        Value="#FEF3C7"/>
														</DataTrigger>
														<DataTrigger Binding="{Binding Action}" Value="Открытие счета">
															<Setter Property="Background" 
																	Value="#DCFCE7"/>
														</DataTrigger>
														<DataTrigger Binding="{Binding Action}" Value="Экспорт в Excel">
															<Setter Property="Background"
																	Value="#FEF3C7"/>
														</DataTrigger>
														<DataTrigger Binding="{Binding Action}" Value="Закрытие счета">
															<Setter Property="Background"
												Value="#db5c5c"/>
														</DataTrigger>
														<DataTrigger Binding="{Binding Action}" Value="Закрытие всех счетов">
															<Setter Property="Background"
												Value="#db5c5c"/>
														</DataTrigger>
														<DataTrigger Binding="{Binding Action}" Value="Блокировка пользователя">
															<Setter Property="Background"
																	Value="#db5c5c"/>
														</DataTrigger>
														<DataTrigger Binding="{Binding Action}" Value="Разблокировка пользователя">
															<Setter Property="Background"
												Value="#DCFCE7"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Border.Style>

											<TextBlock Text="{Binding Action}"
                           FontWeight="SemiBold"/>
										</Border>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>

							<DataGridTemplateColumn Header="Описание" Width="*">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Description}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
						</DataGrid.Columns>
					</DataGrid>
				</StackPanel>
			</Border>
		</Grid>

	</ScrollViewer>

</UserControl>