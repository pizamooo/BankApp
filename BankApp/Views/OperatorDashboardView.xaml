<UserControl x:Class="BankApp.Views.OperatorDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:BankApp.ViewModels"
             mc:Ignorable="d">

	<UserControl.DataContext>
		<vm:OperatorDashboardViewModel/>
	</UserControl.DataContext>

	<ScrollViewer VerticalScrollBarVisibility="Auto">

		<Grid Background="#F4F6F9" Margin="25">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- TOP PANEL -->
			<Border Background="White"
                    CornerRadius="18"
                    Padding="20"
                    Margin="0 0 0 20">

				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="300"/>
					</Grid.ColumnDefinitions>

					<StackPanel>

						<TextBlock Text="Панель оператора"
                                   FontSize="28"
                                   FontWeight="Bold"/>

						<TextBlock Text="Статистика счетов и последних операций"
                                   Foreground="Gray"
                                   Margin="0 5 0 0"/>

					</StackPanel>

					<!-- ACCOUNT SELECT -->
					<StackPanel Grid.Column="1">

						<TextBlock Text="Выбор счета"
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 8"/>

						<ComboBox Height="38"
                                  FontSize="15"
                                  Padding="8"
                                  Background="#F7F8FA"
                                  BorderBrush="#D0D5DD"
                                  BorderThickness="1"
                                  ItemsSource="{Binding Accounts}"
                                  SelectedItem="{Binding SelectedAccount}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True">

							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding AccountNumber}"/>
								</DataTemplate>
							</ComboBox.ItemTemplate>

						</ComboBox>

					</StackPanel>

				</Grid>

			</Border>

			<!-- CARDS -->
			<UniformGrid Grid.Row="1"
                         Columns="3"
                         Margin="0 0 0 20">

				<!-- BALANCE -->
				<Border Background="White"
                        CornerRadius="18"
                        Padding="25"
                        Margin="8">

					<StackPanel>

						<TextBlock Text="Общий баланс"
                                   Foreground="#667085"
                                   FontSize="15"/>

						<TextBlock Text="{Binding TotalBankBalance,StringFormat={}{0:N2} ₽}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Margin="0 12 0 0"/>

					</StackPanel>

				</Border>

				<!-- INCOME -->
				<Border Background="White"
                        CornerRadius="18"
                        Padding="25"
                        Margin="8">

					<StackPanel>

						<TextBlock Text="Доход"
                                   Foreground="#667085"
                                   FontSize="15"/>

						<TextBlock Text="{Binding TotalIncome,StringFormat={}{0:N2} ₽}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   Margin="0 12 0 0"/>

					</StackPanel>

				</Border>

				<!-- EXPENSE -->
				<Border Background="White"
                        CornerRadius="18"
                        Padding="25"
                        Margin="8">

					<StackPanel>

						<TextBlock Text="Расход"
                                   Foreground="#667085"
                                   FontSize="15"/>

						<TextBlock Text="{Binding TotalExpense,StringFormat={}{0:N2} ₽}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#DC2626"
                                   Margin="0 12 0 0"/>

					</StackPanel>

				</Border>

			</UniformGrid>

			<!-- OPERATIONS -->
			<Border Grid.Row="2"
                    Background="White"
                    CornerRadius="18"
                    Padding="20">

				<StackPanel>

					<DockPanel Margin="0 0 0 15">

						<TextBlock Text="Последние операции"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   DockPanel.Dock="Left"/>

						<TextBlock Text="{Binding LastTransactions.Count, StringFormat=Операций: {0}}"
                                   Foreground="Gray"
                                   VerticalAlignment="Bottom"
                                   DockPanel.Dock="Right"
								   Margin="10 0 0 0"/>

					</DockPanel>

					<DataGrid ItemsSource="{Binding LastTransactions}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              RowHeight="42"
                              FontSize="14"
                              Background="White">

						<DataGrid.Columns>

							<DataGridTextColumn Header="ID"
                                                Binding="{Binding Id}"
                                                Width="70"/>

							<DataGridTextColumn Header="Счет"
                                                Binding="{Binding AccountNumber}"
                                                Width="180"/>

							<DataGridTextColumn Header="Сумма"
                                                Binding="{Binding Amount,StringFormat={}{0:N2}}"
                                                Width="130"/>

							<DataGridTextColumn Header="Тип"
                                                Binding="{Binding Type}"
                                                Width="150"/>

							<DataGridTextColumn Header="Дата"
                                                Binding="{Binding Date,StringFormat=dd.MM.yyyy HH:mm}"
                                                Width="190"/>

							<DataGridTemplateColumn Header="Описание" Width="*">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Description}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,4"
                               MaxHeight="80"
                               ToolTip="{Binding Description}"/>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>

						</DataGrid.Columns>

					</DataGrid>

				</StackPanel>

			</Border>

		</Grid>

	</ScrollViewer>

</UserControl>