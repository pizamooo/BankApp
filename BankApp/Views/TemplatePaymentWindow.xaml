<Window x:Class="BankApp.Views.TemplatePaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оплата"
        Height="580"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7FB">

	<Grid Margin="25">

		<Border Background="White"
                CornerRadius="20"
                Padding="25">

			<StackPanel>

				<!-- ICON -->
				<TextBlock x:Name="IconText"
                           FontSize="42"
                           HorizontalAlignment="Center"/>

				<!-- TITLE -->
				<TextBlock x:Name="TitleText"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,15,0,25"
                           HorizontalAlignment="Center"/>

				<!-- LABEL -->
				<TextBlock x:Name="InputLabel"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

				<!-- INPUT -->
				<TextBox x:Name="InputBox"
         Height="40"
         FontSize="14"
         Padding="10"
         Margin="0,0,0,20"
         PreviewTextInput="InputBox_PreviewTextInput"/>

				<StackPanel x:Name="AdditionalPanel"
            Margin="0,0,0,20">

					<TextBlock x:Name="SecondLabel"
               FontWeight="SemiBold"
               Margin="0,0,0,8"/>

					<TextBox x:Name="SecondBox"
             Height="40"
             Padding="10"
             IsReadOnly="True"
             Background="#F3F4F6"/>
				</StackPanel>

				<TextBlock
           FontWeight="SemiBold"
					Text="Сумма"
           Margin="0,0,0,8"/>
				<TextBox x:Name="AmountBox"
         Height="40"
         FontSize="14"
         Padding="10"
         Margin="0,0,0,25"
         PreviewTextInput="AmountBox_PreviewTextInput"/>

				<Button Height="45"
        Content="Оплатить"
        Background="#4F46E5"
        Foreground="White"
        FontWeight="Bold"
        BorderThickness="0"
        Cursor="Hand"
        Click="PayButton_Click"/>
			</StackPanel>

		</Border>

	</Grid>
</Window>