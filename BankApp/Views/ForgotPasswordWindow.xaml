<Window x:Class="BankApp.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Забыли пароль?" Height="460" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF1E1E1E">

	<Grid Margin="30">
		<StackPanel VerticalAlignment="Center">

			<TextBlock Text="Забыли пароль?" 
                       FontSize="26" FontWeight="SemiBold" 
                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30"/>

			<TextBlock Text="Введите ваш логин или номер телефона" 
                       FontSize="15" Foreground="#AAAAAA" Margin="0,0,0,15"
                       TextWrapping="Wrap" TextAlignment="Center"/>

			<Border Style="{StaticResource InputBorder}" Margin="0,0,0,25">
				<TextBox Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"
                         FontSize="16"/>
			</Border>

			<Button Content="Отправить код сброса" 
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SendCodeCommand}"
                    Height="50" Margin="0,0,0,15"/>

			<Button Content="Вернуться к входу" 
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding BackCommand}"/>

			<TextBlock Text="Код будет действителен 15 минут" 
                       FontSize="13" Foreground="#666666" 
                       HorizontalAlignment="Center" Margin="0,25,0,0"/>
		</StackPanel>
	</Grid>
</Window>