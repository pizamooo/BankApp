<UserControl x:Class="BankApp.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BankApp.ViewModels"
             xmlns:conv="clr-namespace:BankApp.Converters">

	<UserControl.DataContext>
		<vm:TransactionsViewModel/>
	</UserControl.DataContext>

	<UserControl.Resources>
		<conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto">

		<Grid Margin="20"
              Background="#F4F6F9">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- HEADER -->
			<Border Background="White"
                    CornerRadius="18"
                    Padding="20"
                    Margin="0 0 0 20">

				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="220"/>
					</Grid.ColumnDefinitions>

					<StackPanel>

						<TextBlock Text="Операции"
                                   FontSize="30"
                                   FontWeight="Bold"/>

						<TextBlock Text="Управление транзакциями и выписками"
                                   Foreground="Gray"
                                   Margin="0 5 0 0"/>

					</StackPanel>
				</Grid>

			</Border>

			<!-- STATS -->
			<UniformGrid Grid.Row="1"
                         Columns="4"
                         Margin="0 0 0 20">

				<!-- BALANCE -->
				<Border Background="White"
                        CornerRadius="15"
                        Padding="20"
                        Margin="6">

					<StackPanel>

						<TextBlock Text="Баланс счета"
                                   Foreground="Gray"
                                   FontSize="14"/>

						<TextBlock Text="{Binding SelectedAccount.Balance,StringFormat={}{0:N2} ₽}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#2E7D32"
                                   Margin="0 10 0 0"/>

					</StackPanel>

				</Border>

				<!-- INCOME -->
				<Border Background="White"
                        CornerRadius="15"
                        Padding="20"
                        Margin="6">

					<StackPanel>

						<TextBlock Text="Доход"
                                   Foreground="Gray"
                                   FontSize="14"/>

						<TextBlock Text="{Binding TotalIncome,StringFormat={}{0:N2} ₽}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   Margin="0 10 0 0"/>

					</StackPanel>

				</Border>

				<!-- EXPENSE -->
				<Border Background="White"
                        CornerRadius="15"
                        Padding="20"
                        Margin="6">

					<StackPanel>

						<TextBlock Text="Расход"
                                   Foreground="Gray"
                                   FontSize="14"/>

						<TextBlock Text="{Binding TotalExpense,StringFormat={}{0:N2} ₽}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#DC2626"
                                   Margin="0 10 0 0"/>

					</StackPanel>

				</Border>

				<!-- COUNT -->
				<Border Background="White"
                        CornerRadius="15"
                        Padding="20"
                        Margin="6">

					<StackPanel>

						<TextBlock Text="Операций"
                                   Foreground="Gray"
                                   FontSize="14"/>

						<TextBlock Text="{Binding Transactions.Count}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"
                                   Margin="0 10 0 0"/>

					</StackPanel>

				</Border>

			</UniformGrid>

			<!-- FORM -->
			<Border Grid.Row="2"
                    Background="White"
                    CornerRadius="18"
                    Padding="20"
                    Margin="0 0 0 20">

				<StackPanel>

					<TextBlock Text="Добавление операции"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0 0 0 15"/>

					<Grid>

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="220"/>
							<ColumnDefinition Width="140"/>
							<ColumnDefinition Width="170"/>
							<ColumnDefinition Width="250"/>
							<ColumnDefinition Width="180"/>
						</Grid.ColumnDefinitions>

						<!-- ACCOUNT -->
						<StackPanel Margin="5">

							<TextBlock Text="Счет"
                                       Foreground="Gray"
                                       FontSize="12"/>

							<ComboBox Height="36"
                                      ItemsSource="{Binding Accounts}"
                                      SelectedItem="{Binding SelectedAccount}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True">

								<ComboBox.ItemTemplate>
									<DataTemplate>

										<StackPanel Orientation="Horizontal">

											<TextBlock Text="{Binding AccountNumber}"/>

											<TextBlock Text=" (закрыт)"
                                                       Margin="5 0 0 0"
                                                       Foreground="Red"
                                                       Visibility="{Binding IsClosed, Converter={StaticResource BooleanToVisibilityConverter}}"/>

										</StackPanel>

									</DataTemplate>
								</ComboBox.ItemTemplate>

							</ComboBox>

						</StackPanel>

						<!-- AMOUNT -->
						<StackPanel Grid.Column="1"
                                    Margin="5">

							<TextBlock Text="Сумма"
                                       Foreground="Gray"
                                       FontSize="12"/>

							<TextBox Height="36"
									 VerticalContentAlignment="Center"
                                     Text="{Binding AmountInput, UpdateSourceTrigger=PropertyChanged}"
									 PreviewTextInput="Amount_PreviewTextInput"
									 PreviewKeyDown="Amount_PreviewKeyDown"/>

						</StackPanel>

						<!-- TYPE -->
						<StackPanel Grid.Column="2"
                                    Margin="5">

							<TextBlock Text="Тип"
                                       Foreground="Gray"
                                       FontSize="12"/>

							<ComboBox Height="36"
                                      ItemsSource="{Binding OperationTypes}"
                                      SelectedItem="{Binding TypeInput}"/>

						</StackPanel>

						<!-- DESCRIPTION -->
						<StackPanel Grid.Column="3"
                                    Margin="5">

							<TextBlock Text="Описание"
                                       Foreground="Gray"
                                       FontSize="12"/>

							<TextBox Height="36"
									 VerticalContentAlignment="Center"
                                     Text="{Binding DescriptionInput}"/>

						</StackPanel>

						<!-- BUTTON -->
						<StackPanel Grid.Column="4"
            Margin="10 0 0 0"
            VerticalAlignment="Bottom">

							<Button Content="✔ Добавить"
            Height="38"
            Margin="0 0 0 8"
            Background="#16A34A"
            Foreground="White"
            FontWeight="Bold"
            BorderThickness="0"
            Command="{Binding AddTransactionCommand}"/>

							<Button Content="✖ Отменить"
            Height="38"
            Background="#DC2626"
            Foreground="White"
									Cursor="Hand"
            FontWeight="Bold"
            BorderThickness="0"
            Command="{Binding CancelTransactionCommand}">

								<Button.Style>
									<Style TargetType="Button">

										<Setter Property="IsEnabled"
                        Value="True"/>

										<Style.Triggers>

											<DataTrigger Binding="{Binding SelectedTransaction.IsCanceled}"
                                 Value="True">

												<Setter Property="IsEnabled"
                                Value="False"/>

											</DataTrigger>

										</Style.Triggers>

									</Style>
								</Button.Style>

							</Button>

						</StackPanel>

					</Grid>

				</StackPanel>

			</Border>

			<!-- FILTER -->
			<Border Grid.Row="3"
        Background="White"
        CornerRadius="18"
        Padding="15"
        Margin="0 0 0 20">

				<WrapPanel VerticalAlignment="Center">

					<!-- Поиск -->
					<StackPanel Margin="0,0,10,10">

						<TextBlock Text="Поиск"
                   FontSize="12"
                   Foreground="Gray"
                   Margin="3,0"/>

						<TextBox Width="150"
                 Height="35"
                 VerticalContentAlignment="Center"
                 Text="{Binding SearchText,
                 UpdateSourceTrigger=PropertyChanged}"/>

					</StackPanel>

					<!-- Дата от -->

					<StackPanel Margin="0,0,10,10">

						<TextBlock Text="Дата от"
                   FontSize="12"
                   Foreground="Gray"
                   Margin="3,0"/>

						<DatePicker Width="140"
                    Height="35"
                    SelectedDate="{Binding DateFrom}"/>

					</StackPanel>

					<!-- Дата до -->

					<StackPanel Margin="0,0,10,10">

						<TextBlock Text="Дата до"
                   FontSize="12"
                   Foreground="Gray"
                   Margin="3,0"/>

						<DatePicker Width="140"
                    Height="35"
                    SelectedDate="{Binding DateTo}"/>

					</StackPanel>

					<!-- Мин сумма -->

					<StackPanel Margin="0,0,10,10">

						<TextBlock Text="Мин. сумма"
                   FontSize="12"
                   Foreground="Gray"
                   Margin="3,0"/>

						<TextBox Width="100"
                 Height="35"
                 VerticalContentAlignment="Center"
                 Text="{Binding MinAmount}"/>

					</StackPanel>

					<!-- Макс сумма -->

					<StackPanel Margin="0,0,10,10">

						<TextBlock Text="Макс. сумма"
                   FontSize="12"
                   Foreground="Gray"
                   Margin="3,0"/>

						<TextBox Width="100"
                 Height="35"
                 VerticalContentAlignment="Center"
                 Text="{Binding MaxAmount}"/>

					</StackPanel>

					<!-- Сортировка -->

					<StackPanel Margin="0,0,10,10">

						<TextBlock Text="Сортировка"
                   FontSize="12"
                   Foreground="Gray"
                   Margin="3,0"/>

						<ComboBox Width="180"
                  Height="35"
                  SelectedItem="{Binding SortOption}">

							<ComboBoxItem Content="Без сортировки"/>
							<ComboBoxItem Content="Сумма ↓"/>
							<ComboBoxItem Content="Сумма ↑"/>

						</ComboBox>

					</StackPanel>

					<!-- Кнопки -->

					<StackPanel Orientation="Horizontal"
                VerticalAlignment="Bottom"
                Margin="15,18,0,0">

						<Button Content="🔍 Фильтр"
                Width="110"
                Height="35"
                Margin="0,0,10,0"
                Command="{Binding FilterCommand}"/>

						<Button Content="↺ Сброс"
                Width="110"
                Height="35"
                Margin="0,0,10,0"
                Command="{Binding ResetFilterCommand}"/>

						<Button Content="📊 Excel"
                Width="110"
                Height="35"
                Margin="0,0,10,0"
                Command="{Binding ExportExcelCommand}"/>

						<Button Content="📄 PDF"
                Width="110"
                Height="35"
                Command="{Binding ExportPdfCommand}"/>

					</StackPanel>

				</WrapPanel>

			</Border>

			<!-- TABLE -->
			<Border Grid.Row="4"
        Background="White"
        CornerRadius="18"
        Padding="20">

				<StackPanel>

					<DockPanel Margin="0,0,0,15">

						<TextBlock Text="История операций"
                       FontSize="22"
                       FontWeight="Bold"
                       DockPanel.Dock="Left"/>

						<TextBlock Text="{Binding Transactions.Count,
                        StringFormat=Операций: {0}}"
                       Foreground="Gray"
                       DockPanel.Dock="Right"/>
					</DockPanel>

					<ScrollViewer VerticalScrollBarVisibility="Auto"
              MaxHeight="500">

						<ListBox ItemsSource="{Binding Transactions}"
             SelectedItem="{Binding SelectedTransaction}"
             BorderThickness="0"
             Background="Transparent">

							<!-- СТИЛЬ КАРТОЧЕК -->
							<ListBox.ItemContainerStyle>

								<Style TargetType="ListBoxItem">

									<Setter Property="Padding"
                Value="0"/>

									<Setter Property="Margin"
                Value="0,0,0,12"/>

									<Setter Property="BorderThickness"
                Value="0"/>

									<Setter Property="HorizontalContentAlignment"
                Value="Stretch"/>

									<Setter Property="Background"
                Value="Transparent"/>

									<Setter Property="Template">

										<Setter.Value>

											<ControlTemplate TargetType="ListBoxItem">

												<Border x:Name="ItemBorder"
                            Background="#F8FAFC"
                            CornerRadius="14"
                            Padding="15">

													<ContentPresenter/>

												</Border>

												<ControlTemplate.Triggers>

													<!-- выделенная карточка -->

													<Trigger Property="IsSelected"
                                 Value="True">

														<Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="#DBEAFE"/>

														<Setter TargetName="ItemBorder"
                                    Property="BorderBrush"
                                    Value="#2563EB"/>

														<Setter TargetName="ItemBorder"
                                    Property="BorderThickness"
                                    Value="2"/>

													</Trigger>

												</ControlTemplate.Triggers>

											</ControlTemplate>

										</Setter.Value>

									</Setter>

									<!-- ВСЕ TRIGGERS ТОЛЬКО ЗДЕСЬ -->

									<Style.Triggers>

										<!-- затемняем отмененные -->

										<DataTrigger Binding="{Binding IsCanceled}"
                         Value="True">

											<Setter Property="Opacity"
                        Value="0.6"/>

										</DataTrigger>

									</Style.Triggers>

								</Style>

							</ListBox.ItemContainerStyle>


							<!-- СОДЕРЖИМОЕ КАРТОЧКИ -->

							<ListBox.ItemTemplate>

								<DataTemplate>

									<Grid>

										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="65"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<!-- ИКОНКА -->

										<Border Width="50"
                            Height="50"
                            CornerRadius="25"
                            Background="#EEF2FF">

											<TextBlock FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">

												<TextBlock.Style>

													<Style TargetType="TextBlock">

														<Setter Property="Text"
                                            Value="💳"/>

														<Style.Triggers>

															<DataTrigger Binding="{Binding Type}"
                                                     Value="Пополнение">

																<Setter Property="Text"
                                                    Value="📈"/>

															</DataTrigger>

															<DataTrigger Binding="{Binding Type}"
                                                     Value="Списание">

																<Setter Property="Text"
                                                    Value="💸"/>

															</DataTrigger>

														</Style.Triggers>

													</Style>

												</TextBlock.Style>

											</TextBlock>

										</Border>


										<!-- ИНФОРМАЦИЯ -->

										<StackPanel Grid.Column="1"
                                Margin="15,0">

											<TextBlock Text="{Binding AccountNumber}"
                                   FontWeight="Bold"/>

											<TextBlock Text="{Binding Description}"
                                   Foreground="#64748B"/>

											<TextBlock Text="{Binding Date,
                                   StringFormat=dd.MM.yyyy HH:mm}"
                                   FontSize="11"
                                   Foreground="#94A3B8"/>

										</StackPanel>


										<!-- ПРАВАЯ ЧАСТЬ -->

										<StackPanel Grid.Column="2">

											<!-- сумма -->

											<TextBlock FontSize="18"
                                   FontWeight="Bold">

												<TextBlock.Style>

													<Style TargetType="TextBlock">

														<Setter Property="Foreground"
                                            Value="#DC2626"/>

														<Setter Property="Text"
                                            Value="{Binding Amount,
                                            StringFormat=-{0:N2} ₽}"/>

														<Style.Triggers>

															<DataTrigger Binding="{Binding Type}"
                                                     Value="Пополнение">

																<Setter Property="Foreground"
                                                    Value="#16A34A"/>

																<Setter Property="Text"
                                                    Value="{Binding Amount,
                                                    StringFormat=+{0:N2} ₽}"/>

															</DataTrigger>

														</Style.Triggers>

													</Style>

												</TextBlock.Style>

											</TextBlock>


											<!-- тип -->

											<Border Padding="8,3"
                                Margin="0,8,0,0"
                                CornerRadius="10">

												<Border.Style>

													<Style TargetType="Border">

														<Setter Property="Background"
                                            Value="#FEE2E2"/>

														<Style.Triggers>

															<DataTrigger Binding="{Binding Type}"
                                                     Value="Пополнение">

																<Setter Property="Background"
                                                    Value="#DCFCE7"/>

															</DataTrigger>

														</Style.Triggers>

													</Style>

												</Border.Style>

												<TextBlock Text="{Binding Type}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

											</Border>


											<!-- статус -->

											<Border Padding="8,3"
                                Margin="0,6,0,0"
                                CornerRadius="10">

												<Border.Style>

													<Style TargetType="Border">

														<Setter Property="Background"
                                            Value="#DCFCE7"/>

														<Style.Triggers>

															<DataTrigger Binding="{Binding IsCanceled}"
                                                     Value="True">

																<Setter Property="Background"
                                                    Value="#FEE2E2"/>

															</DataTrigger>

														</Style.Triggers>

													</Style>

												</Border.Style>

												<TextBlock FontSize="11"
                                       FontWeight="Bold">

													<TextBlock.Style>

														<Style TargetType="TextBlock">

															<Setter Property="Text"
                                                Value="✔ Активна"/>

															<Setter Property="Foreground"
                                                Value="#16A34A"/>

															<Style.Triggers>

																<DataTrigger Binding="{Binding IsCanceled}"
                                                         Value="True">

																	<Setter Property="Text"
                                                        Value="✖ Отменена"/>

																	<Setter Property="Foreground"
                                                        Value="#DC2626"/>

																</DataTrigger>

															</Style.Triggers>

														</Style>

													</TextBlock.Style>

												</TextBlock>

											</Border>

										</StackPanel>

									</Grid>

								</DataTemplate>

							</ListBox.ItemTemplate>

						</ListBox>

					</ScrollViewer>

				</StackPanel>

			</Border>

		</Grid>

	</ScrollViewer>

</UserControl>
