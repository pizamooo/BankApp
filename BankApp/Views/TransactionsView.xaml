<UserControl x:Class="BankApp.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BankApp.ViewModels"
             xmlns:conv="clr-namespace:BankApp.Converters">

	<UserControl.DataContext>
		<vm:TransactionsViewModel/>
	</UserControl.DataContext>

	<UserControl.Resources>
		<conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto">

		<Grid Margin="20"
              Background="#F4F6F9">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- HEADER -->
			<Border Background="White"
                    CornerRadius="18"
                    Padding="20"
                    Margin="0 0 0 20">

				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="220"/>
					</Grid.ColumnDefinitions>

					<StackPanel>

						<TextBlock Text="Операции"
                                   FontSize="30"
                                   FontWeight="Bold"/>

						<TextBlock Text="Управление транзакциями и выписками"
                                   Foreground="Gray"
                                   Margin="0 5 0 0"/>

					</StackPanel>
				</Grid>

			</Border>

			<!-- STATS -->
			<UniformGrid Grid.Row="1"
                         Columns="4"
                         Margin="0 0 0 20">

				<!-- BALANCE -->
				<Border Background="White"
                        CornerRadius="15"
                        Padding="20"
                        Margin="6">

					<StackPanel>

						<TextBlock Text="Баланс счета"
                                   Foreground="Gray"
                                   FontSize="14"/>

						<TextBlock Text="{Binding SelectedAccount.Balance,StringFormat={}{0:N2} ₽}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#2E7D32"
                                   Margin="0 10 0 0"/>

					</StackPanel>

				</Border>

				<!-- INCOME -->
				<Border Background="White"
                        CornerRadius="15"
                        Padding="20"
                        Margin="6">

					<StackPanel>

						<TextBlock Text="Доход"
                                   Foreground="Gray"
                                   FontSize="14"/>

						<TextBlock Text="{Binding TotalIncome,StringFormat={}{0:N2} ₽}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   Margin="0 10 0 0"/>

					</StackPanel>

				</Border>

				<!-- EXPENSE -->
				<Border Background="White"
                        CornerRadius="15"
                        Padding="20"
                        Margin="6">

					<StackPanel>

						<TextBlock Text="Расход"
                                   Foreground="Gray"
                                   FontSize="14"/>

						<TextBlock Text="{Binding TotalExpense,StringFormat={}{0:N2} ₽}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#DC2626"
                                   Margin="0 10 0 0"/>

					</StackPanel>

				</Border>

				<!-- COUNT -->
				<Border Background="White"
                        CornerRadius="15"
                        Padding="20"
                        Margin="6">

					<StackPanel>

						<TextBlock Text="Операций"
                                   Foreground="Gray"
                                   FontSize="14"/>

						<TextBlock Text="{Binding Transactions.Count}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"
                                   Margin="0 10 0 0"/>

					</StackPanel>

				</Border>

			</UniformGrid>

			<!-- FORM -->
			<Border Grid.Row="2"
                    Background="White"
                    CornerRadius="18"
                    Padding="20"
                    Margin="0 0 0 20">

				<StackPanel>

					<TextBlock Text="Добавление операции"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0 0 0 15"/>

					<Grid>

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="220"/>
							<ColumnDefinition Width="140"/>
							<ColumnDefinition Width="170"/>
							<ColumnDefinition Width="250"/>
							<ColumnDefinition Width="180"/>
						</Grid.ColumnDefinitions>

						<!-- ACCOUNT -->
						<StackPanel Margin="5">

							<TextBlock Text="Счет"
                                       Foreground="Gray"
                                       FontSize="12"/>

							<ComboBox Height="36"
                                      ItemsSource="{Binding Accounts}"
                                      SelectedItem="{Binding SelectedAccount}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True">

								<ComboBox.ItemTemplate>
									<DataTemplate>

										<StackPanel Orientation="Horizontal">

											<TextBlock Text="{Binding AccountNumber}"/>

											<TextBlock Text=" (закрыт)"
                                                       Margin="5 0 0 0"
                                                       Foreground="Red"
                                                       Visibility="{Binding IsClosed, Converter={StaticResource BooleanToVisibilityConverter}}"/>

										</StackPanel>

									</DataTemplate>
								</ComboBox.ItemTemplate>

							</ComboBox>

						</StackPanel>

						<!-- AMOUNT -->
						<StackPanel Grid.Column="1"
                                    Margin="5">

							<TextBlock Text="Сумма"
                                       Foreground="Gray"
                                       FontSize="12"/>

							<TextBox Height="36"
									 VerticalContentAlignment="Center"
                                     Text="{Binding AmountInput, UpdateSourceTrigger=PropertyChanged}"
									 PreviewTextInput="Amount_PreviewTextInput"
									 PreviewKeyDown="Amount_PreviewKeyDown"/>

						</StackPanel>

						<!-- TYPE -->
						<StackPanel Grid.Column="2"
                                    Margin="5">

							<TextBlock Text="Тип"
                                       Foreground="Gray"
                                       FontSize="12"/>

							<ComboBox Height="36"
                                      ItemsSource="{Binding OperationTypes}"
                                      SelectedItem="{Binding TypeInput}"/>

						</StackPanel>

						<!-- DESCRIPTION -->
						<StackPanel Grid.Column="3"
                                    Margin="5">

							<TextBlock Text="Описание"
                                       Foreground="Gray"
                                       FontSize="12"/>

							<TextBox Height="36"
									 VerticalContentAlignment="Center"
                                     Text="{Binding DescriptionInput}"/>

						</StackPanel>

						<!-- BUTTON -->
						<StackPanel Grid.Column="4"
            Margin="10 0 0 0"
            VerticalAlignment="Bottom">

							<Button Content="✔ Добавить"
            Height="38"
            Margin="0 0 0 8"
            Background="#16A34A"
            Foreground="White"
            FontWeight="Bold"
            BorderThickness="0"
            Command="{Binding AddTransactionCommand}"/>

							<Button Content="✖ Отменить"
            Height="38"
            Background="#DC2626"
            Foreground="White"
            FontWeight="Bold"
            BorderThickness="0"
            Command="{Binding CancelTransactionCommand}">

								<Button.Style>
									<Style TargetType="Button">

										<Setter Property="IsEnabled"
                        Value="True"/>

										<Style.Triggers>

											<DataTrigger Binding="{Binding SelectedTransaction.IsCanceled}"
                                 Value="True">

												<Setter Property="IsEnabled"
                                Value="False"/>

											</DataTrigger>

										</Style.Triggers>

									</Style>
								</Button.Style>

							</Button>

						</StackPanel>

					</Grid>

				</StackPanel>

			</Border>

			<!-- FILTER -->
			<Border Grid.Row="3"
                    Background="White"
                    CornerRadius="18"
                    Padding="15"
                    Margin="0 0 0 20">

				<DockPanel LastChildFill="False">
					<!-- SEARCH -->
					<TextBox Width="150"
                             Height="35"
                             Margin="0 0 15 0"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Поиск по описанию"/>

					<!-- DATES -->
					<DatePicker Width="140"
                                SelectedDate="{Binding DateFrom}"/>

					<DatePicker Width="140"
                                Margin="10 0"
                                SelectedDate="{Binding DateTo}"/>

					<!-- BUTTONS -->
					<Button Content="Фильтр"
                            Width="110"
                            Margin="10 0"
                            Command="{Binding FilterCommand}"/>

					<Button Content="Сброс"
                            Width="100"
                            Margin="5 0"
                            Command="{Binding ResetFilterCommand}"/>

					<Button Content="📊 Excel"
                            Width="110"
                            Margin="25 0 0 0"
                            Command="{Binding ExportExcelCommand}"/>

					<Button Content="📄 PDF"
                            Width="110"
                            Margin="10 0 0 0"
                            Command="{Binding ExportPdfCommand}"/>

				</DockPanel>

			</Border>

			<!-- TABLE -->
			<Border Grid.Row="4"
                    Background="White"
                    CornerRadius="18"
                    Padding="15">

				<DataGrid ItemsSource="{Binding Transactions}"
						  SelectedItem="{Binding SelectedTransaction}"
						  AlternatingRowBackground="#F9FAFB"
						  CanUserResizeColumns="False"
						  CanUserAddRows="False"
						  SelectionMode="Single"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
						  RowBackground="White"
                          GridLinesVisibility="None"
                          RowHeight="40"
                          IsReadOnly="True"
                          BorderThickness="0"
                          FontSize="14"
                          Background="White">

					<DataGrid.Columns>

						<DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="40"/>

						<DataGridTextColumn Header="Счет"
                                            Binding="{Binding AccountNumber}"
                                            Width="130"/>

						<!-- AMOUNT -->
						<DataGridTextColumn Header="Сумма"
                                            Width="120">

							<DataGridTextColumn.Binding>
								<Binding Path="Amount"
                                         StringFormat="{}{0:N2} ₽"/>
							</DataGridTextColumn.Binding>

							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">

									<Setter Property="FontWeight"
                                            Value="Bold"/>

									<Style.Triggers>

										<DataTrigger Binding="{Binding Type}"
                                                     Value="Пополнение">

											<Setter Property="Foreground"
                                                    Value="#16A34A"/>

										</DataTrigger>

										<DataTrigger Binding="{Binding Type}"
                                                     Value="Списание">

											<Setter Property="Foreground"
                                                    Value="#DC2626"/>

										</DataTrigger>

									</Style.Triggers>

								</Style>
							</DataGridTextColumn.ElementStyle>

						</DataGridTextColumn>

						<DataGridTextColumn Header="Тип"
                                            Binding="{Binding Type}"
                                            Width="140"/>

						<DataGridTextColumn Header="Дата"
                                            Width="180">

							<DataGridTextColumn.Binding>
								<Binding Path="Date"
                                         StringFormat="dd.MM.yyyy HH:mm"/>
							</DataGridTextColumn.Binding>

						</DataGridTextColumn>

						<DataGridTextColumn Header="Описание"
                                            Binding="{Binding Description}"
                                            Width="*"/>

						<DataGridTextColumn Header="Статус"
                    Width="120">

							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">

									<Setter Property="Text" Value="Активна"/>

									<Style.Triggers>

										<DataTrigger Binding="{Binding IsCanceled}" Value="True">
											<Setter Property="Text" Value="Отменена"/>
											<Setter Property="Foreground" Value="Red"/>
											<Setter Property="FontWeight" Value="Bold"/>
										</DataTrigger>

									</Style.Triggers>

								</Style>

							</DataGridTextColumn.ElementStyle>

						</DataGridTextColumn>

					</DataGrid.Columns>
					<DataGrid.RowStyle>
						<Style TargetType="DataGridRow">

							<Style.Triggers>

								<DataTrigger Binding="{Binding IsCanceled}" Value="True">
									<Setter Property="Opacity" Value="0.45"/>
								</DataTrigger>

							</Style.Triggers>

						</Style>
					</DataGrid.RowStyle>

				</DataGrid>

			</Border>
			<TextBlock Text="Поиск по описанию"
           Foreground="Gray"
           FontSize="12" Margin="15,3,875,75" Grid.Row="3"/>

		</Grid>

	</ScrollViewer>

</UserControl>
