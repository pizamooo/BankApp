<Window x:Class="BankApp.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сброс пароля" Height="590" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF1E1E1E">

	<Grid Margin="30">
		<StackPanel VerticalAlignment="Center">

			<TextBlock Text="Восстановление пароля" 
                       FontSize="26" FontWeight="SemiBold" 
                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30"/>

			<TextBlock Text="Введите код из SMS" 
                       FontSize="15" Foreground="#AAAAAA" Margin="0,0,0,8"/>

			<Border Style="{StaticResource InputBorder}" Margin="0,0,0,20">
				<TextBox x:Name="tbCode" 
                         Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"
                         MaxLength="6"
                         FontSize="18" HorizontalContentAlignment="Center"/>
			</Border>

			<TextBlock Text="Новый пароль" 
                       FontSize="15" Foreground="#AAAAAA" Margin="0,0,0,8"/>

			<Border Style="{StaticResource InputBorder}" Margin="0,0,0,10">
				<PasswordBox x:Name="pbNewPassword" 
                             Style="{StaticResource PasswordBoxStyle}"/>
			</Border>

			<TextBlock Text="Повторите пароль" 
                       FontSize="15" Foreground="#AAAAAA" Margin="0,0,0,8"/>

			<Border Style="{StaticResource InputBorder}" Margin="0,0,0,25">
				<PasswordBox x:Name="pbConfirmPassword" 
                             Style="{StaticResource PasswordBoxStyle}"/>
			</Border>

			<Button Content="Сменить пароль" 
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ResetPasswordCommand}"
                    Height="48" Margin="0,0,0,15"/>

			<Button Content="Назад" 
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding BackCommand}"/>
		</StackPanel>
	</Grid>
</Window>