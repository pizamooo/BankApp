<UserControl x:Class="BankApp.Views.TopUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid Background="#F5F7FB">

		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<ScrollViewer>

			<StackPanel Width="430" Margin="25">

				<!-- HEADER -->
				<TextBlock Text="💳 Пополнение счёта"
                           FontSize="30"
                           FontWeight="Bold"
                           Margin="0,0,0,25"/>

				<!-- CARD -->
				<Border Background="White"
                        CornerRadius="18"
                        Padding="20">

					<StackPanel>

						<TextBlock Text="Выберите счёт"
                                   FontWeight="SemiBold"/>

						<ComboBox ItemsSource="{Binding Accounts}"
                                  SelectedItem="{Binding SelectedAccount}"
                                  DisplayMemberPath="Iban"
                                  Height="42"
                                  Margin="0,6,0,15"/>

						<TextBlock Text="Сумма пополнения"
                                   FontWeight="SemiBold"/>

						<TextBox Text="{Binding AmountText}"
                                 Height="42"
                                 Padding="10"
                                 Margin="0,6,0,15"/>

						<Button Content="Пополнить"
                                Height="48"
                                Background="#2563EB"
                                Foreground="White"
                                FontWeight="Bold"
                                Command="{Binding TopUpCommand}"/>

						<TextBlock Text="{Binding Info}"
                                   Margin="0,15,0,0"
                                   Foreground="#DC2626"
                                   FontWeight="SemiBold"/>

					</StackPanel>

				</Border>

			</StackPanel>

		</ScrollViewer>

		<!-- BACK -->
		<Border Grid.Row="1"
                Background="White"
                Padding="18">

			<Button Content="← Назад"
                    Width="140"
					FontWeight="Bold"
                    Height="42"
                    Background="#2563EB"
                    Foreground="White"
                    Command="{Binding GoBackCommand}"/>

		</Border>

	</Grid>
</UserControl>