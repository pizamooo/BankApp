<UserControl x:Class="BankApp.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BankApp.ViewModels"
             xmlns:conv="clr-namespace:BankApp.Converters"
             Background="#F4F6F9">

	<UserControl.DataContext>
		<vm:AccountsViewModel/>
	</UserControl.DataContext>
	<UserControl.Resources>

		<conv:BooleanToVisibilityConverter
        x:Key="BooleanToVisibilityConverter"/>

	</UserControl.Resources>
	<ScrollViewer VerticalScrollBarVisibility="Auto">

		<Grid Margin="20">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- ================= HEADER ================= -->

			<Border Background="White" CornerRadius="18" Padding="25" Margin="0 0 0 20">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<!-- ЛЕВАЯ ЧАСТЬ -->
					<StackPanel>
						<TextBlock Text="Банковские счета" FontSize="30" FontWeight="Bold"/>
						<TextBlock Text="Управление счетами клиентов" Foreground="Gray" Margin="0 5 0 0"/>
					</StackPanel>
					<!-- КНОПКА ЭКСПОРТА -->
					<Button Grid.Column="1" Content="📄 Экспорт PDF" Width="180" Height="42" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Top" Command="{Binding ExportAccountsCommand}">
						<Button.Style>
							<Style TargetType="Button">
								<Setter Property="Opacity" Value="1"/>
								<Style.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter Property="Opacity" Value="0.85"/>
									</Trigger>
								</Style.Triggers>
							</Style>
						</Button.Style>
					</Button>
				</Grid>
			</Border>

			<!-- ================= STATS ================= -->

			<UniformGrid Grid.Row="1"
                         Columns="4"
                         Margin="0 0 0 20">

				<!-- ВСЕГО -->
				<Border Background="White"
                        CornerRadius="16"
                        Padding="20"
                        Margin="6">

					<StackPanel>

						<TextBlock Text="Всего счетов"
                                   Foreground="Gray"
                                   FontSize="14"/>

						<TextBlock Text="{Binding Accounts.Count}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0 10 0 0"/>

					</StackPanel>

				</Border>

				<!-- АКТИВНЫЕ -->
				<Border Background="White"
                        CornerRadius="16"
                        Padding="20"
                        Margin="6">

					<StackPanel>

						<TextBlock Text="Активные"
                                   Foreground="Gray"
                                   FontSize="14"/>

						<TextBlock Text="{Binding ActiveAccountsCount}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   Margin="0 10 0 0"/>

					</StackPanel>

				</Border>

				<!-- ЗАКРЫТЫЕ -->
				<Border Background="White"
                        CornerRadius="16"
                        Padding="20"
                        Margin="6">

					<StackPanel>

						<TextBlock Text="Закрытые"
                                   Foreground="Gray"
                                   FontSize="14"/>

						<TextBlock Text="{Binding ClosedAccountsCount}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#DC2626"
                                   Margin="0 10 0 0"/>

					</StackPanel>

				</Border>

				<!-- ОБЩИЙ БАЛАНС -->
				<Border Background="White"
                        CornerRadius="16"
                        Padding="20"
                        Margin="6">

					<StackPanel>

						<TextBlock Text="Общий баланс"
                                   Foreground="Gray"
                                   FontSize="14"/>

						<TextBlock Text="{Binding TotalBalance,
                                          StringFormat={}{0:N2} ₽}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"
                                   Margin="0 10 0 0"/>

					</StackPanel>

				</Border>

			</UniformGrid>
			
			

			<!-- ================= CREATE PANEL ================= -->

			<Border Grid.Row="2"
                    Background="White"
                    CornerRadius="18"
                    Padding="20"
                    Margin="0 0 0 20">

				<StackPanel>

					<TextBlock Text="Создание нового счета"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0 0 0 20"/>

					<Grid>

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="220"/>
							<ColumnDefinition Width="240"/>
							<ColumnDefinition Width="190"/>
							<ColumnDefinition Width="130"/>
							<ColumnDefinition Width="180"/>
						</Grid.ColumnDefinitions>

						<!-- ПОИСК -->
						<StackPanel Margin="5">

							<TextBlock Text="Поиск по телефону"
                                       FontSize="12"
                                       Foreground="Gray"/>

							<TextBox Height="38"
                                     VerticalContentAlignment="Center"
                                     Padding="10 0"
                                     Text="{Binding PhoneSearch,
                                     UpdateSourceTrigger=PropertyChanged}"/>

						</StackPanel>

						<!-- КЛИЕНТ -->
						<StackPanel Grid.Column="1"
                                    Margin="5">

							<TextBlock Text="Клиент"
                                       FontSize="12"
                                       Foreground="Gray"/>

							<ComboBox Height="38"
                                      Padding="5"
                                      ItemsSource="{Binding FilteredClients}"
                                      SelectedItem="{Binding SelectedClient}"
                                      DisplayMemberPath="FullName"/>

						</StackPanel>

						<!-- СЧЕТ -->
						<StackPanel Grid.Column="2"
                                    Margin="5">

							<TextBlock Text="Номер счета"
                                       FontSize="12"
                                       Foreground="Gray"/>

							<TextBox Height="38"
                                     VerticalContentAlignment="Center"
									 PreviewTextInput="AccountNumber_PreviewTextInput"
                                     Padding="10 0"
                                     Text="{Binding NewAccountNumber,
                                            UpdateSourceTrigger=PropertyChanged}"/>
							<StackPanel Grid.Column="2"
            Margin="5">

								<TextBlock Text="IBAN"
               FontSize="12"
               Foreground="Gray"/>

								<TextBox Height="38"
             IsReadOnly="True"
             Background="#F3F4F6"
             Foreground="#2563EB"
             FontWeight="Bold"
             VerticalContentAlignment="Center"
             Padding="10 0"
             Text="{Binding GeneratedIban}"/>

							</StackPanel>

						</StackPanel>

						<!-- БАЛАНС -->
						<StackPanel Grid.Column="3"
                                    Margin="5">

							<TextBlock Text="Баланс"
                                       FontSize="12"
                                       Foreground="Gray"/>

							<TextBox Height="38"
                                     VerticalContentAlignment="Center"
                                     Padding="10 0"
									 PreviewTextInput="Balance_PreviewTextInput"
									 KeyDown="Balance_PreviewKeyDown"
                                     Text="{Binding NewBalance, UpdateSourceTrigger=PropertyChanged}"/>

						</StackPanel>

						<!-- КНОПКА -->
						<StackPanel Grid.Column="4"
                                    Margin="10 0 0 0"
                                    VerticalAlignment="Center">

							<Button Content="＋ Создать"
                                    Height="40"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Background="#2563EB"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding AddAccountCommand}">

								<Button.Style>

									<Style TargetType="Button">

										<Setter Property="Opacity"
                                                Value="1"/>

										<Style.Triggers>

											<Trigger Property="IsMouseOver"
                                                     Value="True">

												<Setter Property="Opacity"
                                                        Value="0.85"/>

											</Trigger>

										</Style.Triggers>

									</Style>

								</Button.Style>

							</Button>

						</StackPanel>

					</Grid>

				</StackPanel>

			</Border>

			<Border Grid.Row="4" Background="#80000000"
            Visibility="{Binding IsLoading,
            Converter={StaticResource BooleanToVisibilityConverter}}">

				<StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

					<ProgressBar Width="220"
                         Height="10"
                         IsIndeterminate="True"/>

					<TextBlock Text="Загрузка счетов..."
                       Foreground="White"
                       FontSize="16"
                       Margin="0 15 0 0"
                       HorizontalAlignment="Center"/>

				</StackPanel>

			</Border>

			<Border Grid.Row="3"
        Background="White"
        CornerRadius="18"
        Padding="15"
        Margin="0 0 0 15">

				<WrapPanel VerticalAlignment="Center">

					<!-- ПОИСК -->
					<StackPanel Margin="0 0 15 0">

						<TextBlock Text="Поиск"
                       FontSize="12"
                       Foreground="Gray"/>

						<TextBox Width="220"
                     Height="38"
                     Padding="10 0"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchText,
                     UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Поиск по номеру счета"/>

					</StackPanel>

					<!-- ТОЛЬКО АКТИВНЫЕ -->
					<CheckBox Content="Только активные"
                  Margin="0 0 20 0"
                  VerticalAlignment="Center"
                  IsChecked="{Binding ShowOnlyActive}"/>

					<!-- ТОЛЬКО ЗАКРЫТЫЕ -->
					<CheckBox Content="Только закрытые"
                  Margin="0 0 20 0"
                  VerticalAlignment="Center"
                  IsChecked="{Binding ShowOnlyClosed}"/>

					<!-- С БАЛАНСОМ -->
					<CheckBox Content="Баланс > 0"
                  Margin="0 0 20 0"
                  VerticalAlignment="Center"
                  IsChecked="{Binding ShowPositiveBalance}"/>

					<!-- СОРТИРОВКА -->
					<ComboBox Width="180"
                  SelectedIndex="{Binding SortIndex}">

						<ComboBoxItem Content="По умолчанию"/>
						<ComboBoxItem Content="Баланс ↑"/>
						<ComboBoxItem Content="Баланс ↓"/>
						<ComboBoxItem Content="Номер счета"/>

					</ComboBox>

				</WrapPanel>

			</Border>

			<Border Grid.Row="4"
                    Background="White"
                    CornerRadius="18"
                    Padding="15">

				<DataGrid ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedAccount}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          BorderThickness="0"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="#F9FAFB"
                          RowBackground="White"
                          RowHeight="45"
                          FontSize="14"
                          CanUserResizeColumns="False">

					<DataGrid.RowStyle>

						<Style TargetType="DataGridRow">

							<Setter Property="Background"
                                    Value="White"/>

							<Style.Triggers>

								<Trigger Property="IsMouseOver"
                                         Value="True">

									<Setter Property="Background"
                                            Value="#EEF4FF"/>

								</Trigger>

								<DataTrigger Binding="{Binding IsClosed}"
                                             Value="True">

									<Setter Property="Opacity"
                                            Value="0.45"/>

								</DataTrigger>

							</Style.Triggers>

						</Style>

					</DataGrid.RowStyle>

					<DataGrid.Columns>

						<!-- СЧЕТ -->
						<DataGridTextColumn Header="Номер счета"
                                            Binding="{Binding AccountNumber}"
                                            Width="*"/>

						<!-- БАЛАНС -->
						<DataGridTextColumn Header="Баланс"
                                            Width="160">

							<DataGridTextColumn.Binding>

								<Binding Path="Balance"
                                         StringFormat="{}{0:N2} ₽"/>

							</DataGridTextColumn.Binding>

							<DataGridTextColumn.ElementStyle>

								<Style TargetType="TextBlock">

									<Setter Property="FontWeight"
                                            Value="Bold"/>

									<Setter Property="Foreground"
                                            Value="#2563EB"/>

								</Style>

							</DataGridTextColumn.ElementStyle>

						</DataGridTextColumn>
						<DataGridTextColumn Header="IBAN"
											Binding="{Binding Iban}"
											Width="260"/>

						<!-- КЛИЕНТ -->
						<DataGridTextColumn Header="ID клиента"
                                            Binding="{Binding ClientId}"
                                            Width="130"/>

						<!-- СТАТУС -->
						<DataGridTemplateColumn Header="Статус"
                                                Width="150">

							<DataGridTemplateColumn.CellTemplate>

								<DataTemplate>

									<Border CornerRadius="10"
                                            Padding="10 4"
                                            HorizontalAlignment="Center">

										<TextBlock FontWeight="Bold">

											<TextBlock.Style>

												<Style TargetType="TextBlock">

													<Setter Property="Text"
                                                            Value="🟢 Активен"/>

													<Setter Property="Foreground"
                                                            Value="#16A34A"/>

													<Style.Triggers>

														<DataTrigger Binding="{Binding IsClosed}"
                                                                     Value="True">

															<Setter Property="Text"
                                                                    Value="🔴 Закрыт"/>

															<Setter Property="Foreground"
                                                                    Value="#DC2626"/>

														</DataTrigger>

													</Style.Triggers>

												</Style>

											</TextBlock.Style>

										</TextBlock>

									</Border>

								</DataTemplate>

							</DataGridTemplateColumn.CellTemplate>

						</DataGridTemplateColumn>

					</DataGrid.Columns>
					

				</DataGrid>

			</Border>
			<StackPanel Grid.Row="4"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Visibility="{Binding IsEmptyStateVisible,
            Converter={StaticResource BooleanToVisibilityConverter}}">

				<TextBlock Text="🏦"
               FontSize="72"
               HorizontalAlignment="Center"/>

				<TextBlock Text="Счета не найдены"
               FontSize="28"
               FontWeight="Bold"
               Margin="0 10 0 0"
               HorizontalAlignment="Center"/>

				<TextBlock Text="Попробуйте изменить фильтры или создать новый счет"
               Foreground="Gray"
               FontSize="15"
               Margin="0 10 0 0"
               HorizontalAlignment="Center"/>

			</StackPanel>

			<!-- ================= ACTIONS ================= -->

			<Border Grid.Row="5"
                    Background="White"
                    CornerRadius="18"
                    Padding="20"
                    Margin="0 20 0 0">

				<StackPanel>

					<TextBlock Text="Управление счетами"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0 0 0 15"/>

					<WrapPanel>

						<!-- CLOSE -->
						<Button Content="🔒 Закрыть счет"
                                Width="190"
                                Height="42"
                                Margin="0 0 10 0"
                                Background="#DC2626"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Command="{Binding CloseAccountCommand}"/>

						<!-- OPEN -->
						<Button Content="🔓 Открыть счет"
                                Width="190"
                                Height="42"
                                Margin="0 0 10 0"
                                Background="#16A34A"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Command="{Binding OpenAccountCommand}"/>

						<!-- CLOSE ALL -->
						<Button Content="⚠ Закрыть все счета клиента"
                                Width="220"
                                Height="42"
                                Background="#F59E0B"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Command="{Binding CloseAllAccountsCommand}"/>

					</WrapPanel>

				</StackPanel>

			</Border>

		</Grid>

	</ScrollViewer>

</UserControl>