<UserControl x:Class="BankApp.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BankApp.ViewModels"
             xmlns:conv="clr-namespace:BankApp.Converters">

	<UserControl.DataContext>
		<vm:AccountsViewModel/>
	</UserControl.DataContext>

	<UserControl.Resources>
		<conv:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
	</UserControl.Resources>

	<Grid Margin="20">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- ================= HEADER ================= -->
		<TextBlock Text="Счета"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0 0 0 15"/>

		<!-- ================= CREATE PANEL ================= -->
		<Border Grid.Row="2"
        Background="White"
        CornerRadius="10"
        Padding="15"
        Margin="0 0 0 15">

			<StackPanel>

				<TextBlock Text="Создание счета"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0 0 0 10"/>

				<WrapPanel>

					<!-- ВЫБОР КЛИЕНТА -->
					<StackPanel Margin="10">
						<TextBlock Text="Клиент"
                           FontSize="12"
                           Foreground="Gray"/>

						<ComboBox Width="220"
                          ItemsSource="{Binding FilteredClients}"
								  IsEditable="True"
                          DisplayMemberPath="FullName"
                          SelectedItem="{Binding SelectedClient}"/>
					</StackPanel>

					<!-- ТЕЛЕФОН -->
					<StackPanel Margin="10">
						<TextBlock Text="Телефон"
                           FontSize="12"
                           Foreground="Gray"/>

						<TextBlock Text="{Binding SelectedClientPhone}"
                           FontSize="14"
                           FontWeight="Bold"/>
					</StackPanel>

					<!-- НОМЕР СЧЕТА -->
					<StackPanel Margin="10">
						<TextBlock Text="№ счета"
                           FontSize="12"
                           Foreground="Gray"/>

						<TextBox Width="180"
                         Text="{Binding NewAccountNumber, UpdateSourceTrigger=PropertyChanged}"/>
					</StackPanel>

					<!-- БАЛАНС -->
					<StackPanel Margin="10">
						<TextBlock Text="Баланс"
                           FontSize="12"
                           Foreground="Gray"/>

						<TextBox Width="120"
                         Text="{Binding NewBalance}"
                         ToolTip="По умолчанию 0"/>
					</StackPanel>

					<!-- КНОПКА -->
					<StackPanel Margin="10" VerticalAlignment="Bottom">
						<Button Content="Создать"
                        Width="150"
                        Height="35"
                        Command="{Binding AddAccountCommand}"/>
					</StackPanel>

				</WrapPanel>

			</StackPanel>

		</Border>

		<!-- ================= DATA GRID ================= -->
		<DataGrid Grid.Row="3"
          ItemsSource="{Binding Accounts}"
          SelectedItem="{Binding SelectedAccount}"
          AutoGenerateColumns="False"
				  GridLinesVisibility="None"
          IsReadOnly="True"
          Margin="0 10 0 0">

			<DataGrid.RowStyle>
				<Style TargetType="DataGridRow">
					<Style.Triggers>
						<DataTrigger Binding="{Binding IsClosed}" Value="True">
							<Setter Property="Opacity" Value="0.4"/>
							<Setter Property="Foreground" Value="Gray"/>
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</DataGrid.RowStyle>

			<DataGrid.Columns>
				<DataGridTextColumn Header="Счет" Binding="{Binding AccountNumber}" Width="*"/>
				<DataGridTextColumn Header="Баланс" Binding="{Binding Balance}" Width="120"/>
				<DataGridTextColumn Header="Клиент ID" Binding="{Binding ClientId}" Width="100"/>
				<DataGridTextColumn Header="Статус" Binding="{Binding IsClosed}" Width="100"/>
			</DataGrid.Columns>
		</DataGrid>

		<!-- ================= ACTION PANEL ================= -->
		<Border Grid.Row="4"
        Background="White"
        CornerRadius="10"
        Padding="15"
        Margin="0 10 0 0">

			<StackPanel>

				<TextBlock Text="Управление счетами"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0 0 0 10"/>

				<WrapPanel HorizontalAlignment="Left">

					<Button Content="Закрыть выбранный счет"
                    Width="180"
                    Height="35"
                    Margin="10"
                    Command="{Binding CloseAccountCommand}"/>

					<Button Content="Открыть выбранный счет"
                    Width="180"
                    Height="35"
                    Margin="10"
                    Command="{Binding OpenAccountCommand}"/>

					<Button Content="Закрыть все счета клиента"
                    Width="190"
                    Height="35"
                    Margin="10"
                    Command="{Binding CloseAllAccountsCommand}"/>

				</WrapPanel>

			</StackPanel>

		</Border>

	</Grid>

</UserControl>