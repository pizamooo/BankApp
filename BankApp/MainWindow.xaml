<Window x:Class="BankApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BankApp.ViewModels"
        Title="Bank System"
        Height="700"
        Width="1300"
		MinHeight="700"
		MinWidth="1100"
        Background="#F4F6F9"
        WindowStartupLocation="CenterScreen">

	<Window.DataContext>
		<vm:MainViewModel/>
	</Window.DataContext>
	
	<Grid>

		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- TOP BAR -->
		<Border Background="#1F2937" Grid.Row="0">
			<Grid>

				<TextBlock Text="🏦 Bank System (Diploma Project)"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="15"/>

				<TextBlock Text="Совкомбанк - Demo"
                       Foreground="#9CA3AF"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,15,0"/>
			</Grid>
		</Border>

		<!-- BODY -->
		<Grid Grid.Row="1">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="{Binding SidebarWidth}"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- SIDEBAR -->
			<Border Background="#111827">

				<StackPanel Margin="10">

					<TextBlock Text="МЕНЮ"
                           Foreground="#9CA3AF"
                           Margin="10"
                           FontSize="12"/>
					<Button Content="📋 Общая информация" 
							Command="{Binding ShowDashboardCommand}"
							Visibility="{Binding IsOperator,Converter={StaticResource BoolToVisibilityConverter}}"/>

					<Button Content="📊 Операции"
                        Command="{Binding ShowTransactionsCommand}"
                        Visibility="{Binding IsOperator,Converter={StaticResource BoolToVisibilityConverter}}"/>

					<Button Content="🏦 Счета"
                        Command="{Binding ShowAccountsCommand}"
                        Visibility="{Binding IsOperator,Converter={StaticResource BoolToVisibilityConverter}}"/>

					<Button Content="Переводы"
                        Command="{Binding ShowTransfersCommand}"
                        Visibility="{Binding IsClient,Converter={StaticResource BoolToVisibilityConverter}}"/>

					<Button Content="Админ панель"
							Command="{Binding ShowAdminDashboardCommand}"
							Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>

					<Button Content="Пользователи"
							Command="{Binding ShowUsersCommand}"
							Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>

				</StackPanel>

			</Border>

			<!-- CONTENT -->
			<ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}" />

		</Grid>

	</Grid>
</Window>